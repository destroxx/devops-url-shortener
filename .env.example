# Copy this file to `.env` and fill in real values for local development:
#     cp .env.example .env
#
# `.env` is gitignored; THIS file is committed. That split is the whole point:
# the repo documents WHICH settings exist without ever containing their values.
# A new developer can see everything they need to configure, and no secret is
# ever at risk of being pushed.

# --- Identity -----------------------------------------------------------------
APP_NAME=url-shortener
# Overwritten at build time with the git SHA, so a running container can always
# tell you exactly which commit it came from.
APP_VERSION=dev
ENVIRONMENT=local

# --- Database -----------------------------------------------------------------
# SQLite by default: zero setup, no server to run.
DATABASE_URL=sqlite:///./shortener.db
# For the Docker Compose stack, use the Postgres service instead. Note the host
# is `db` -- the SERVICE NAME from docker-compose.yml, not localhost. Compose
# gives each service a DNS name on a shared network.
# DATABASE_URL=postgresql://shortener:localdevpassword@db:5432/shortener

# --- HTTP ---------------------------------------------------------------------
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Behaviour ----------------------------------------------------------------
SHORT_CODE_LENGTH=7
